{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qmatch://schemas/core_method_v2/structured_explanation_config_v1.schema.json",
  "title": "StructuredExplanationConfigV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_id",
    "config_version",
    "registry_version",
    "status",
    "calibration_status",
    "runtime_status",
    "production_approval_status",
    "scientifically_validated",
    "maximum_total_signals",
    "maximum_signals_per_category",
    "maximum_signals_per_module",
    "minimum_signal_confidence",
    "high_confidence_threshold",
    "moderate_confidence_threshold",
    "structural_close_threshold",
    "structural_difference_threshold",
    "preference_strong_fit_threshold",
    "preference_weak_fit_threshold",
    "value_strong_fit_threshold",
    "value_weak_fit_threshold",
    "asymmetry_reporting_threshold",
    "score_difference_tolerance",
    "soft_conflict_reporting_bands",
    "missing_evidence_reporting_policy",
    "hard_constraint_reporting_policy",
    "confidence_adjustment_reporting_policy",
    "deduplication_policy",
    "diversity_policy",
    "tie_breaking_policy",
    "localization_mode",
    "ai_generation_status",
    "persona_input_status",
    "frequency_type_status",
    "complementarity_status",
    "version_compatibility_policy",
    "category_priority",
    "source_component_order"
  ],
  "properties": {
    "config_id": { "type": "string" },
    "config_version": { "type": "string" },
    "registry_version": { "type": "string" },
    "status": { "const": "provisional" },
    "calibration_status": { "const": "uncalibrated" },
    "runtime_status": { "const": "offline_only" },
    "production_approval_status": { "const": "not_approved" },
    "scientifically_validated": { "const": false },
    "maximum_total_signals": { "type": "integer", "minimum": 1 },
    "maximum_signals_per_category": { "type": "integer", "minimum": 1 },
    "maximum_signals_per_module": { "type": "integer", "minimum": 1 },
    "minimum_signal_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "high_confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "moderate_confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "structural_close_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "structural_difference_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "preference_strong_fit_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "preference_weak_fit_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "value_strong_fit_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "value_weak_fit_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "asymmetry_reporting_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "score_difference_tolerance": { "type": "number", "minimum": 0 },
    "soft_conflict_reporting_bands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missing_evidence_reporting_policy": { "type": "string" },
    "hard_constraint_reporting_policy": { "type": "string" },
    "confidence_adjustment_reporting_policy": { "type": "string" },
    "deduplication_policy": { "type": "string" },
    "diversity_policy": { "type": "string" },
    "tie_breaking_policy": { "type": "string" },
    "localization_mode": { "const": "structured_code_and_parameters" },
    "ai_generation_status": { "const": "prohibited" },
    "persona_input_status": { "const": "prohibited" },
    "frequency_type_status": { "const": "prohibited" },
    "complementarity_status": { "const": "disabled" },
    "version_compatibility_policy": { "type": "string" },
    "category_priority": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_component_order": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "object" }
  }
}
