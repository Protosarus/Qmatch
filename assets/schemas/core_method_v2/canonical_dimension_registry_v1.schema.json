{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qmatch://schemas/core_method_v2/canonical_dimension_registry_v1.schema.json",
  "title": "CanonicalDimensionRegistryV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "registry_version",
    "schema_version",
    "status",
    "dimensions"
  ],
  "properties": {
    "registry_id": { "type": "string", "minLength": 1 },
    "registry_version": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "status": { "type": "string" },
    "calibration_status": { "type": "string" },
    "active_dimension_count": { "type": "integer", "minimum": 0 },
    "total_dimension_count": { "type": "integer", "minimum": 0 },
    "notes": { "type": "object" },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension_id",
          "module",
          "status",
          "registry_version",
          "display_order",
          "normalized_score_min",
          "normalized_score_max",
          "supports_partner_preference",
          "supports_similarity",
          "supports_complementarity",
          "supports_hard_constraint",
          "default_matching_role",
          "current_calibration_status",
          "description",
          "prohibited_interpretations"
        ],
        "properties": {
          "dimension_id": { "type": "string", "minLength": 1 },
          "module": { "enum": ["iq", "eq", "frequency"] },
          "status": { "type": "string" },
          "registry_version": { "type": "string" },
          "display_order": { "type": "integer" },
          "normalized_score_min": { "type": "number", "minimum": 0, "maximum": 1 },
          "normalized_score_max": { "type": "number", "minimum": 0, "maximum": 1 },
          "supports_partner_preference": { "type": "boolean" },
          "supports_similarity": { "type": "boolean" },
          "supports_complementarity": { "type": "boolean" },
          "supports_hard_constraint": { "type": "boolean" },
          "default_matching_role": { "type": "string" },
          "current_calibration_status": { "type": "string" },
          "description": { "type": "string" },
          "prohibited_interpretations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
