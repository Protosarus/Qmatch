{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qmatch://schemas/core_method_v2/structured_explanation_code_registry_v1.schema.json",
  "title": "StructuredExplanationCodeRegistryV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "registry_version",
    "canonical_dimension_registry_version",
    "status",
    "production_approval_status",
    "codes"
  ],
  "properties": {
    "registry_id": { "type": "string" },
    "registry_version": { "type": "string" },
    "canonical_dimension_registry_version": { "type": "string" },
    "status": { "const": "provisional" },
    "production_approval_status": { "const": "not_approved" },
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "explanation_code",
          "category",
          "polarity",
          "default_localization_key",
          "allowed_source_types",
          "required_parameters",
          "optional_parameters",
          "blocking_eligibility",
          "privacy_level",
          "production_status",
          "description",
          "prohibited_interpretations"
        ],
        "properties": {
          "explanation_code": { "type": "string" },
          "category": { "type": "string" },
          "polarity": {
            "enum": ["supportive", "cautionary", "neutral", "unavailable", "blocking"]
          },
          "default_localization_key": { "type": "string" },
          "allowed_source_types": {
            "type": "array",
            "items": { "type": "string" }
          },
          "required_parameters": {
            "type": "array",
            "items": { "type": "string" }
          },
          "optional_parameters": {
            "type": "array",
            "items": { "type": "string" }
          },
          "blocking_eligibility": { "type": "boolean" },
          "privacy_level": { "type": "string" },
          "production_status": { "type": "string" },
          "description": { "type": "string" },
          "prohibited_interpretations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
