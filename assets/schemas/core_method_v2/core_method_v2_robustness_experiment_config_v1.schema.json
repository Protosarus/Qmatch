{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qmatch://schemas/core_method_v2/core_method_v2_robustness_experiment_config_v1.schema.json",
  "title": "CoreMethodV2RobustnessExperimentConfigV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_id",
    "config_version",
    "registry_version",
    "status",
    "calibration_status",
    "runtime_status",
    "production_approval_status",
    "scientifically_validated",
    "baseline_seed",
    "secondary_seeds",
    "synthetic_population_size",
    "sampled_pair_count",
    "full_pipeline_pair_count",
    "explanation_pair_count",
    "score_bounds",
    "confidence_bounds",
    "quantile_points",
    "histogram_bin_count",
    "correlation_alert_thresholds",
    "score_saturation_thresholds",
    "neutral_concentration_window",
    "neutral_concentration_alert_threshold",
    "weight_perturbation_levels",
    "scale_perturbation_levels",
    "threshold_perturbation_levels",
    "missingness_rates",
    "confidence_noise_levels",
    "score_noise_levels",
    "rank_stability_metrics",
    "explanation_stability_metrics",
    "calibration_readiness_requirements",
    "real_user_data_policy",
    "synthetic_family_ids",
    "modes",
    "complementarity_status",
    "temporal_layer_status",
    "persona_input_status",
    "frequency_type_status",
    "ai_scoring_status",
    "soft_conflict_penalty_status"
  ],
  "properties": {
    "config_id": { "type": "string" },
    "config_version": { "type": "string" },
    "registry_version": { "type": "string" },
    "status": { "const": "provisional" },
    "calibration_status": { "const": "uncalibrated" },
    "runtime_status": { "const": "offline_only" },
    "production_approval_status": { "const": "not_approved" },
    "scientifically_validated": { "const": false },
    "baseline_seed": { "type": "integer" },
    "secondary_seeds": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "integer" }
    },
    "synthetic_population_size": { "type": "integer", "minimum": 1 },
    "sampled_pair_count": { "type": "integer", "minimum": 1 },
    "full_pipeline_pair_count": { "type": "integer", "minimum": 1 },
    "explanation_pair_count": { "type": "integer", "minimum": 1 },
    "subjects_per_family_full_sweep": { "type": "integer", "minimum": 1 },
    "pairs_per_family_full_sweep": { "type": "integer", "minimum": 1 },
    "full_pipeline_pairs_per_family_full_sweep": {
      "type": "integer",
      "minimum": 1
    },
    "explanation_pairs_per_family_full_sweep": {
      "type": "integer",
      "minimum": 1
    },
    "primary_deep_dive_family": { "type": "string" },
    "score_bounds": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "confidence_bounds": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "quantile_points": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "histogram_bin_count": { "type": "integer", "minimum": 2 },
    "correlation_alert_thresholds": {
      "type": "object",
      "required": ["moderate", "high", "very_high"],
      "additionalProperties": false,
      "properties": {
        "moderate": { "type": "number" },
        "high": { "type": "number" },
        "very_high": { "type": "number" }
      }
    },
    "score_saturation_thresholds": {
      "type": "object",
      "required": [
        "low_tail_proportion",
        "high_tail_proportion",
        "narrow_variance"
      ],
      "additionalProperties": false,
      "properties": {
        "low_tail_proportion": { "type": "number" },
        "high_tail_proportion": { "type": "number" },
        "narrow_variance": { "type": "number" }
      }
    },
    "neutral_concentration_window": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "neutral_concentration_alert_threshold": { "type": "number" },
    "weight_perturbation_levels": {
      "type": "array",
      "items": { "type": "number" }
    },
    "scale_perturbation_levels": {
      "type": "array",
      "items": { "type": "number" }
    },
    "threshold_perturbation_levels": {
      "type": "array",
      "items": { "type": "number" }
    },
    "missingness_rates": {
      "type": "array",
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "confidence_noise_levels": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "score_noise_levels": {
      "type": "array",
      "items": { "type": "number", "minimum": 0 }
    },
    "rank_stability_metrics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "explanation_stability_metrics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "calibration_readiness_requirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "real_user_data_policy": { "const": "forbidden_in_this_phase" },
    "synthetic_family_ids": {
      "type": "array",
      "minItems": 26,
      "items": { "type": "string" }
    },
    "opaque_cohort_labels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "modes": {
      "type": "object",
      "required": ["smoke", "full"],
      "additionalProperties": false,
      "properties": {
        "smoke": { "type": "object" },
        "full": { "type": "object" }
      }
    },
    "injected_evaluation_timestamp_utc": { "type": "string" },
    "frozen_source_configs": { "type": "object" },
    "complementarity_status": { "const": "disabled" },
    "temporal_layer_status": { "const": "disabled" },
    "persona_input_status": { "const": "forbidden" },
    "frequency_type_status": { "const": "forbidden" },
    "ai_scoring_status": { "const": "forbidden" },
    "soft_conflict_penalty_status": { "const": "disabled" },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
