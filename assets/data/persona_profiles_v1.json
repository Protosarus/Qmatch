    },
    "numerical": {
      "low": {"tr": "Nitel değerlendirmeyi tercih etme", "en": "Preference for qualitative evaluation"},
      "high": {"tr": "Nicel ilişkileri kullanma", "en": "Using quantitative relationships"}
    },
    "empathy": {
      "low": {"tr": "Önce görev veya kendi konumuna odaklanma", "en": "Prioritizing the task or one's own position"},
      "high": {"tr": "Karşı tarafın duygusunu hesaba katma", "en": "Accounting for the other person's feelings"}
    },
    "selfAwareness": {
      "low": {"tr": "İç durumunu eylem sırasında keşfetme", "en": "Discovering one's inner state through action"},
      "high": {"tr": "Kendi duygu ve ihtiyacını erken fark etme", "en": "Recognizing one's feelings and needs early"}
    },
    "emotionalRegulation": {
      "low": {"tr": "Duyguyu hızlı ve doğrudan dışa vurma", "en": "Expressing emotion quickly and directly"},
      "high": {"tr": "Yoğun duyguda tepkiyi düzenleme", "en": "Regulating responses under intense emotion"}
    },
    "boundaries": {
      "low": {"tr": "Yakınlık ve esnek erişilebilirliği önceleme", "en": "Prioritizing closeness and flexible availability"},
      "high": {"tr": "Kişisel sınırları açık ve tutarlı koruma", "en": "Maintaining clear and consistent personal boundaries"}
    },
    "assertiveness": {
      "low": {"tr": "Gözlemleyip davet bekleme", "en": "Observing and waiting for an invitation"},
      "high": {"tr": "Açık konuşup inisiyatif alma", "en": "Speaking directly and taking initiative"}
    },
    "perspectiveTaking": {
      "low": {"tr": "Tek bir tutarlı çerçevede kalma", "en": "Staying within one consistent frame"},
      "high": {"tr": "Birden fazla bakış açısını tartma", "en": "Weighing multiple perspectives"}
    },
    "repairOrientation": {
      "low": {"tr": "Kırılma sonrası mesafe ve kapanışı tercih etme", "en": "Preferring distance or closure after rupture"},
      "high": {"tr": "Kırılma sonrası bağı onarmaya yönelme", "en": "Moving to repair connection after rupture"}
    },
    "autonomy": {
      "low": {"tr": "Kararları ilişkiyle yakın eşgüdümleme", "en": "Closely coordinating decisions with the relationship"},
      "high": {"tr": "Yakınlık içinde kendi yönünü koruma", "en": "Maintaining one's own direction within closeness"}
    },
    "adaptability": {
      "low": {"tr": "Öngörülebilir yaklaşımı sürdürme", "en": "Maintaining a predictable approach"},
      "high": {"tr": "Koşula göre yaklaşımı değiştirme", "en": "Changing approach with circumstances"}
    },
    "intuitiveSensitivity": {
      "low": {"tr": "Açık ve doğrulanabilir sinyallere dayanma", "en": "Relying on explicit and verifiable signals"},
      "high": {"tr": "Söylenmeyen ton ve sinyalleri fark etme", "en": "Noticing unspoken tone and signals"}
