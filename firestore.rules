rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function sortedPairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function matchPath(matchId) {
      return /databases/$(database)/documents/matches/$(matchId);
    }

    function blockPath(fromUid, toUid) {
      return /databases/$(database)/documents/users/$(fromUid)/blocks/$(toUid);
    }

    function blockExists(fromUid, toUid) {
      return exists(blockPath(fromUid, toUid));
    }

    function noBlocksBetween(a, b) {
      return !blockExists(a, b) && !blockExists(b, a);
    }

    function likeExists(fromUid, toUid) {
      return exists(
          /databases/$(database)/documents/users/$(fromUid)/swipes/$(toUid)
        )
        && get(
          /databases/$(database)/documents/users/$(fromUid)/swipes/$(toUid)
        ).data.direction == 'like';
    }

    /// Active match only — document existence alone is never enough.
    function activeMatchExists(matchId) {
      return exists(matchPath(matchId))
        && get(matchPath(matchId)).data.state == 'active';
    }

    function activeMatchData(matchId) {
      return get(matchPath(matchId)).data;
    }

    /// Peer profile / Discover “matched with” — requires ACTIVE membership.
    function isMatchedWith(otherUid) {
      let id = sortedPairId(request.auth.uid, otherUid);
      return isSignedIn()
        && activeMatchExists(id)
        && request.auth.uid in activeMatchData(id).users;
    }

    function isMatchMember() {
      return isSignedIn()
        && resource.data.keys().hasAny(['users'])
        && request.auth.uid in resource.data.users;
    }

    function isActiveMatchMember() {
      return isMatchMember() && resource.data.state == 'active';
    }

    function isMatchMemberOnCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasAny(['users'])
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2;
    }

    function matchUsersValid(matchId) {
      return request.resource.data.users.size() == 2
        && request.resource.data.user_a is string
        && request.resource.data.user_b is string
        && request.resource.data.user_a < request.resource.data.user_b
        && request.resource.data.users.hasAll([
          request.resource.data.user_a,
          request.resource.data.user_b
        ])
        && matchId == sortedPairId(
          request.resource.data.user_a,
          request.resource.data.user_b
        );
    }

    function mutualLikeForMatchCreate() {
      let a = request.resource.data.user_a;
      let b = request.resource.data.user_b;
      return likeExists(a, b) && likeExists(b, a);
    }

    function matchCreateBlocksClear() {
      return noBlocksBetween(
        request.resource.data.user_a,
        request.resource.data.user_b
      );
    }

    /// Client may close/block a match but must not rematch via update.
    /// Allowed: active→unmatched|blocked, unmatched→blocked, same-state idempotent.
    function matchStateUpdateAllowed() {
      return request.resource.data.state == resource.data.state
        || (
          resource.data.state == 'active'
          && (
            request.resource.data.state == 'unmatched'
            || request.resource.data.state == 'blocked'
          )
        )
        || (
          resource.data.state == 'unmatched'
          && request.resource.data.state == 'blocked'
        );
    }

    function isThreadParticipant() {
      return isSignedIn()
        && resource.data.keys().hasAny(['participants'])
        && request.auth.uid in resource.data.participants;
    }

    function isThreadParticipantOnCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasAny(['participants'])
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
    }

    function threadData(threadId) {
      return get(/databases/$(database)/documents/threads/$(threadId)).data;
    }

    function isParticipantOfThread(threadId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/threads/$(threadId))
        && request.auth.uid in threadData(threadId).participants;
    }

    function threadParticipantsSortedOnCreate() {
      return request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0]
          < request.resource.data.participants[1];
    }

    /// Thread create requires corresponding ACTIVE match; matchId == threadId.
    function threadCreateRequiresActiveMatch(threadId) {
      return request.resource.data.match_id == threadId
        && request.resource.data.status == 'active'
        && activeMatchExists(threadId)
        && activeMatchData(threadId).thread_id == threadId
        && activeMatchData(threadId).users.hasAll(
          request.resource.data.participants
        )
        && noBlocksBetween(
          request.resource.data.participants[0],
          request.resource.data.participants[1]
        );
    }

    /// Soft consistency: thread may not be reopened unless match is active.
    function threadStatusUpdateAllowed(threadId) {
      return request.resource.data.status == resource.data.status
        || request.resource.data.status == 'closed'
        || (
          request.resource.data.status == 'active'
          && activeMatchExists(threadId)
        );
    }

    function messageRequiresActiveConversation(threadId) {
      return isParticipantOfThread(threadId)
        && threadData(threadId).status == 'active'
        && activeMatchExists(threadId);
    }

    // Server-owned / derived fields clients must not mutate after create.
    // Current AuthService/Profile flows still attempt some of these writes —
    // that is a documented release blocker until a trusted backend owns them.
    // Canonical public display name (`name`) may be updated by the owner.
    // Protected derived keys remain immutable via userProtectedKeysUnchanged().
    function userProtectedKeysUnchanged() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      // Owner may revoke discover_eligible to false (deletion / soft leave).
      // Self-granting discover_eligible == true remains forbidden.
      let eligibleOk = !affected.hasAny(['discover_eligible'])
        || request.resource.data.discover_eligible == false;
      return eligibleOk && !affected.hasAny([
        'iq_score',
        'eq_score',
        'compatibility',
        'compat',
        'moderation_state',
        'moderation_status',
        'account_deletion_status',
        'uid'
      ]);
    }

    function userCreateProtectedDefaultsOk() {
      return request.resource.data.uid == request.auth.uid
        && (
          !('discover_eligible' in request.resource.data)
          || request.resource.data.discover_eligible == false
        );
    }

    // Deny-by-default for unknown paths.
    match /{document=**} {
      allow read, write: if false;
    }

    // users/{uid}
    match /users/{uid} {
      // Owner full get; Discover candidates when eligible; ACTIVE matched peers.
      allow get: if isOwner(uid)
        || (isSignedIn() && resource.data.discover_eligible == true)
        || isMatchedWith(uid);

      // List required for Discover query; each returned doc still must pass get.
      allow list: if isSignedIn();

      allow create: if isOwner(uid) && userCreateProtectedDefaultsOk();
      allow update: if isOwner(uid) && userProtectedKeysUnchanged();
      allow delete: if false;

      match /assessment_assignments/{type} {
        allow read, write: if isOwner(uid);
      }

      // Private assessment answers / evidence / confidence — owner only.
      match /assessments/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Canonical 20D profile fragment (IQ/EQ/Frequency merge target).
      // Owner-only; not public. Delete denied (retain audit trail).
      match /profiles/canonical_v1 {
        allow read, create, update: if isOwner(uid);
        allow delete: if false;
      }

      // Owner writes own swipes; target may read reverse swipe for mutual-like checks.
      match /swipes/{targetUid} {
        allow read: if isSignedIn()
          && (request.auth.uid == uid || request.auth.uid == targetUid);
        allow create, update: if isOwner(uid);
        allow delete: if false;
      }

      match /blocks/{blockedUid} {
        allow read, write: if isOwner(uid);
        allow delete: if isOwner(uid);
      }
    }

    // assessment_sets/{setId} — client seed/upload helpers intentionally denied.
    match /assessment_sets/{setId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // questions/{docId} — legacy fallback read only.
    match /questions/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // matches/{matchId} — ACTIVE membership for read; create with mutual likes + no blocks.
    match /matches/{matchId} {
      allow read: if isActiveMatchMember();
      allow create: if isMatchMemberOnCreate()
        && matchUsersValid(matchId)
        && mutualLikeForMatchCreate()
        && matchCreateBlocksClear()
        && request.resource.data.state == 'active'
        && request.resource.data.thread_id == matchId;
      allow update: if isMatchMember()
        && request.resource.data.users == resource.data.users
        && request.resource.data.user_a == resource.data.user_a
        && request.resource.data.user_b == resource.data.user_b
        && request.resource.data.thread_id == resource.data.thread_id
        && matchStateUpdateAllowed()
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['compat', 'compatibility']);
      allow delete: if false;
    }

    // threads/{threadId} — create only with corresponding ACTIVE match (id mirrored).
    match /threads/{threadId} {
      allow read: if isThreadParticipant();
      allow create: if isThreadParticipantOnCreate()
        && request.resource.data.participants.size() == 2
        && threadParticipantsSortedOnCreate()
        && threadId == sortedPairId(
          request.resource.data.participants[0],
          request.resource.data.participants[1]
        )
        && threadCreateRequiresActiveMatch(threadId);
      allow update: if isThreadParticipant()
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.match_id == resource.data.match_id
        && threadStatusUpdateAllowed(threadId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipantOfThread(threadId);
        // Normal messages: auth uid only (no open system spoof).
        // Bootstrap system message: fixed id system_match_v1 only.
        allow create: if messageRequiresActiveConversation(threadId)
          && (
            (
              request.resource.data.sender_id == request.auth.uid
              && request.resource.data.type == 'text'
            )
            || (
              messageId == 'system_match_v1'
              && request.resource.data.sender_id == 'system'
              && request.resource.data.type == 'system'
              && request.resource.data.text == 'You matched!'
            )
          );
        allow update, delete: if false;
      }
    }

    // reports/{reportId} — reporter create only; no client reads (incl. unrelated users).
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporter_uid == request.auth.uid
        && request.resource.data.reported_uid is string
        && request.resource.data.reported_uid != request.auth.uid
        && request.resource.data.status == 'new';
      allow read, update, delete: if false;
    }

    // account_deletion_requests/{uid} — owner-controlled request docs only.
    match /account_deletion_requests/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'requested';
      allow update: if isOwner(uid)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'requested'
        && resource.data.status == 'requested';
      allow delete: if false;
    }

    // entitlements/{uid} — Resonance entitlement snapshot (`resonance_entitlement_firestore_schema_v1`).
    // Owner GET only. Client never creates/updates/deletes. Ledger Admin-only.
    match /entitlements/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /entitlements/{uid}/purchase_ledger/{ledgerId} {
      allow get, list, create, update, delete: if false;
    }

    // store_purchase_index — ASSN/RTDN uid lookup. Admin-only.
    match /store_purchase_index/{indexId} {
      allow read, write: if false;
    }
  }
}
